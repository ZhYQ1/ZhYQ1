name: Generate Profile Animations
on:
  schedule:
    - cron: '0 0 * * *'      # 每天零点（UTC）更新
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  generate:
    permissions:
      contents: write
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - uses: actions/checkout@v4

      # ---- 动画 1：Pacman ----
      - name: Generate pacman graph
        uses: DuyetBKU/viz-pacman-github-profile@main
        with:
          github_user_name: ZhYQ1
          github_token: ${{ secrets.GITHUB_TOKEN }}
          theme: react-dark
          music: 'false'

      # ---- 动画 2：Gravity ----
      - name: Generate gravity svg
        uses: flycran/github-gravity@v1
        with:
          username: ZhYQ1
          text: Hello GitHub     # 可改成你想要的字，比如 ZhYQ1
          output-path: dist/gravity.svg
          css: true

      # ---- 统一推送 ----
      - name: Push all to output branch
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./dist
          publish_branch: output
          keep_files: true      # 保留已有文件，防止互删
